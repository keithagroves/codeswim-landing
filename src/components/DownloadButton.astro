---
const REPO = 'keithagroves/codeswim';
const RELEASES = `https://github.com/${REPO}/releases/latest`;

// Bake the direct .dmg URL in at build time so the static markup already points
// at a real download (no-JS visitors, API rate limits). The codeswim repo
// re-triggers this deploy whenever a release is published, so a fresh build
// always sees the newest asset. The client script below refreshes at runtime.
type Asset = { name: string; browser_download_url: string };
let macUrl = RELEASES;
let version = '';
try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = (await res.json()) as { tag_name?: string; assets?: Asset[] };
    version = data.tag_name ?? '';
    macUrl = data.assets?.find((a) => a.name.endsWith('.dmg'))?.browser_download_url ?? RELEASES;
  }
} catch {
  // offline build — keep releases-page fallback
}
---

<div class="download" data-releases={RELEASES} data-version={version}>
  <a class="primary" href={macUrl} id="primary-download">
    <span class="icon" id="primary-icon">↓</span>
    <span class="label">
      <span class="lead">Download for Mac</span>
      <span class="sub" id="primary-sub">Apple silicon · .dmg{version ? ` · ${version}` : ''}</span>
    </span>
  </a>
  <p class="note"><a href={RELEASES} id="other-platforms">Other platforms</a></p>
</div>

<script>
  // Mac-only: refresh the .dmg link and version at runtime in case the page was
  // built before the latest release.
  type Asset = { name: string; browser_download_url: string };

  const root = document.querySelector<HTMLDivElement>('.download');
  const primary = document.getElementById('primary-download') as HTMLAnchorElement | null;
  const sub = document.getElementById('primary-sub');
  const other = document.getElementById('other-platforms') as HTMLAnchorElement | null;

  // Report clicks to Google Analytics so downloads show up as events, not just
  // page views. gtag is defined globally on the page.
  type Gtag = (...args: unknown[]) => void;
  const track = (label: string, href: string) => {
    const gtag = (window as unknown as { gtag?: Gtag }).gtag;
    if (typeof gtag === 'function') {
      gtag('event', 'download_click', { platform: label, link_url: href });
    }
  };
  primary?.addEventListener('click', () => track('mac', primary.href));
  other?.addEventListener('click', () => track('other', other.href));

  if (root && primary && sub) {
    fetch('https://api.github.com/repos/keithagroves/codeswim/releases/latest', {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data: { assets: Asset[]; tag_name?: string }) => {
        const hit = data.assets.find((a) => a.name.endsWith('.dmg'));
        if (hit) primary.href = hit.browser_download_url;
        const v = data.tag_name ?? root.dataset.version;
        sub.textContent = v ? `Apple silicon · .dmg · ${v}` : 'Apple silicon · .dmg';
      })
      .catch(() => {
        // keep the baked link already in the markup
      });
  }
</script>

<style>
  .download {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .primary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 2rem;
    background: #111;
    color: #fff;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 12px 28px -12px rgba(0, 0, 0, 0.35);
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    border: 1px solid #222;
  }
  .primary:hover {
    transform: translateY(-1px);
    background: #1c1c1c;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset, 0 16px 32px -12px rgba(0, 0, 0, 0.45);
  }
  .icon {
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0.85;
  }
  .label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }
  .lead {
    font-size: 1.05rem;
  }
  .sub {
    font-size: 0.78rem;
    opacity: 0.65;
    font-weight: 400;
    margin-top: 2px;
  }
  .note {
    font-size: 0.82rem;
    color: #888;
    margin: 0;
  }
  .note a {
    color: #888;
    text-decoration: none;
    border-bottom: 1px dotted #ccc;
  }
  .note a:hover {
    color: #333;
    border-bottom-color: #333;
  }
</style>
